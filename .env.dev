# 应用基础
NODE_ENV=dev
APP_PORT=8000

# 跨域来源白名单（逗号分隔），留空时仅放行本地开发前端
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 会话类型：jwt | redis-token
SESSION_TYPE=jwt

# 数据库（TypeORM）
MYSQL_HOST=www.youlai.tech
MYSQL_PORT=3306
MYSQL_USER=youlai
MYSQL_PASSWORD=123456
MYSQL_DB=youlai_admin
# SQL 日志：开发 true，生产 false
TYPEORM_LOGGING=true

# Redis
REDIS_HOST=www.youlai.tech
REDIS_PORT=6379
REDIS_DB=0
# 无密码时留空
REDIS_PASSWORD=123456

# 认证
# 密钥（HS256 至少 32 字符）
JWT_SECRET_KEY=SecretKey012345678901234567890123456789012345678901234567890123456789
# 访问令牌有效期（秒）
JWT_EXPIRES_IN=7200
# 令牌签发方标识
JWT_ISSUER=youlai-nest

# 对象存储（类型：aliyun | s3 | local）
OSS_TYPE=s3

# S3（RustFS）
OSS_S3_ENDPOINT=http://127.0.0.1:9000
OSS_S3_REGION=us-east-1
OSS_S3_ACCESS_KEY=rustfs-admin
OSS_S3_SECRET_KEY=rustfs-admin
OSS_S3_BUCKET=public
OSS_S3_CUSTOM_DOMAIN=

# 阿里云 OSS
OSS_ALIYUN_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ALIYUN_ACCESS_KEY_ID=your-access-key-id
OSS_ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
OSS_ALIYUN_BUCKET=default

# 本地存储路径（仅 OSS_TYPE=local 时生效）
OSS_LOCAL_STORAGE_PATH=D:/data/oss/

# 微信小程序
WX_MINIAPP_APP_ID=Your_AppId
WX_MINIAPP_APP_SECRET=Your_AppSecret

# 限流（窗口单位：秒）
RATE_LIMIT_IP_ENABLED=true
RATE_LIMIT_IP_LIMIT=1000
RATE_LIMIT_IP_WINDOW_SEC=60
RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_WINDOW_SEC=60

# AI（OpenAI 兼容接口，地址需以 /v1 结尾）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 留空时接口返回「AI 功能未开启」；本地开发用环境变量覆盖，不要提交自己的 Key
AI_API_KEY=
# 模型：qwen-plus / qwen-turbo / qwen-max 等
AI_MODEL=qwen-plus
# 单次请求超时（毫秒）
AI_TIMEOUT_MS=20000
